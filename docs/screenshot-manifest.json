  "scenes": [
    {
      "id": "workspace",
      "description": "Video preview, single-file queue, and Output > General with processing mode, output name, MP4 container, and output dimensions."
    },
    {
      "id": "batch-queue",
      "description": "Mixed queue with a video, JPEG photograph, and PCM audio file. The video is selected and General output controls are open. Apply to all is unavailable for these incompatible source types."
    },
    {
      "id": "presets",
      "description": "Native built-in preset list, with Balanced MP4 matching the selected video configuration."
    },
    {
      "id": "video-output",
      "description": "Video controls for resolution, scaling, frame rate, libx264 encoder, pixel format, encoding speed, and constant quality."
    },
    {
      "id": "video-filters",
      "description": "Expanded Video filters with the native color adjustment, tone, and detail controls at their defaults."
    },
    {
      "id": "audio-output",
      "description": "A real PCM WAV source with MP3 output codec, channel, quality, bitrate, and source-track controls. The music icon is the native audio preview."
    },
    {
      "id": "audio-filters",
      "description": "Expanded Audio filters showing level, normalization, limiter, dynamics, and tone controls for the PCM WAV source."
    },
    {
      "id": "images-output",
      "description": "JPEG source with General and Images expanded: PNG output, original dimensions, scaling, pixel format, and PNG compression controls."
    },
    {
      "id": "crop-preview",
      "description": "Native crop editing overlay on the JPEG source, including handles, grid, Free aspect selection, reset, and Apply."
    },
    {
      "id": "subtitles",
      "description": "Selectable subtitle mode and the real embedded English mov_text source track with Exclude/Include controls. No external subtitle file is imported."
    },
    {
      "id": "source-metadata",
      "description": "Probed metadata for the real sample MP4: eight-second duration, H.264 High 1280x720 at 24 fps, and stereo AAC audio."
    },
    {
      "id": "output-metadata",
      "description": "Output metadata in Preserve mode, with editable title, artist, album, and further metadata fields."
    },
    {
      "id": "settings",
      "description": "Native Settings drawer with unconfigured output folder, appearance, UI scale, max concurrency, and update preferences."
    },
    {
      "id": "trim-preview",
      "description": "Native trim range and playback controls over the eight-second video preview, with Start and End timecode fields."
    },
    {
      "id": "source-error",
      "description": "A deliberately invalid .mp4 is processed by the real import/probe path. The native UI reports Preview unavailable and Failed to read source metadata. This is a reproducible troubleshooting example, not a simulated application error."
    }
  ],
