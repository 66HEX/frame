+#define FRAME_PREVIEW_HEADER_BYTES 80
+
+static int preview_metadata_uint(const AVFrame *frame, const char *key,
+                                 unsigned *value, int allow_zero)
+{
+    const AVDictionaryEntry *entry = av_dict_get(frame->metadata, key, NULL, 0);
+    char *end;
+    unsigned long long v;
+    if (!entry || entry->value[0] < '0' || entry->value[0] > '9')
+        return AVERROR_INVALIDDATA;
+    errno = 0;
+    v = strtoull(entry->value, &end, 10);
+    if (errno || *end || v > INT_MAX || (!allow_zero && !v))
+        return AVERROR_INVALIDDATA;
+    *value = v;
+    return 0;
+}
+
+static int preview_capture_frame(OutputStream *ost, AVFrame *frame, FrameData *fd)
+{
+    unsigned ow, oh, sn, sd;
+    int ret;
+    if (!(frame->flags & AV_FRAME_FLAG_FRAME_PREVIEW_CAPTURED) ||
+        ost->enc->enc_ctx->codec_id != AV_CODEC_ID_RAWVIDEO ||
+        frame->format != AV_PIX_FMT_BGRA || frame->width <= 0 || frame->height <= 0)
+        return AVERROR_INVALIDDATA;
+    if ((ret = preview_metadata_uint(frame, "frame.preview.v1.ow", &ow, 0)) < 0 ||
+        (ret = preview_metadata_uint(frame, "frame.preview.v1.oh", &oh, 0)) < 0 ||
+        (ret = preview_metadata_uint(frame, "frame.preview.v1.sar_num", &sn, 1)) < 0 ||
+        (ret = preview_metadata_uint(frame, "frame.preview.v1.sar_den", &sd, 0)) < 0)
+        return ret;
+    if (frame->pts != AV_NOPTS_VALUE &&
+        (frame->time_base.num <= 0 || frame->time_base.den <= 0))
+        return AVERROR_INVALIDDATA;
+    fd->preview.valid = 1;
+    fd->preview.width = frame->width;
+    fd->preview.height = frame->height;
+    fd->preview.output_width = ow;
+    fd->preview.output_height = oh;
+    fd->preview.sar = (AVRational){ sn, sn ? sd : 1 };
+    fd->preview.pts = frame->pts;
+    fd->preview.tb = frame->time_base;
+    fd->preview.decoder_index = fd->dec.frame_num;
+    fd->preview.input_index = ost->enc->frames_encoded;
+    return 0;
+}
+
+static int preview_prepend_header(AVPacket *pkt, const FrameData *fd, uint64_t sequence)
+{
+    uint64_t payload;
+    unsigned flags = 0;
+    uint8_t *b;
+    int ret;
+    if (!fd->preview.valid || fd->preview.input_index != sequence)
+        return AVERROR_INVALIDDATA;
+    payload = (uint64_t)fd->preview.width * fd->preview.height * 4;
+    if (payload > INT_MAX - FRAME_PREVIEW_HEADER_BYTES || payload != pkt->size)
+        return AVERROR_INVALIDDATA;
+    if ((ret = av_packet_make_writable(pkt)) < 0 ||
+        (ret = av_grow_packet(pkt, FRAME_PREVIEW_HEADER_BYTES)) < 0)
+        return ret;
+    b = pkt->data;
+    memmove(b + FRAME_PREVIEW_HEADER_BYTES, b, payload);
+    memset(b, 0, FRAME_PREVIEW_HEADER_BYTES);
+    if (fd->preview.sar.num) flags |= 1;
+    if (fd->preview.pts != AV_NOPTS_VALUE) flags |= 2;
+    if (fd->preview.decoder_index != UINT64_MAX) flags |= 4;
+    memcpy(b, "FRMPV001", 8);
+    AV_WL16(b + 8, FRAME_PREVIEW_HEADER_BYTES);
+    AV_WL16(b + 10, flags);
+    AV_WL32(b + 12, 1);
+    AV_WL64(b + 16, payload);
+    AV_WL64(b + 24, sequence);
+    AV_WL64(b + 32, fd->preview.pts);
+    AV_WL32(b + 40, (flags & 2) ? fd->preview.tb.num : 0);
+    AV_WL32(b + 44, (flags & 2) ? fd->preview.tb.den : 0);
+    AV_WL32(b + 48, fd->preview.width);
+    AV_WL32(b + 52, fd->preview.height);
+    AV_WL32(b + 56, fd->preview.output_width);
+    AV_WL32(b + 60, fd->preview.output_height);
+    AV_WL32(b + 64, fd->preview.sar.num);
+    AV_WL32(b + 68, fd->preview.sar.den);
+    AV_WL64(b + 72, fd->preview.decoder_index);
+    return 0;
+}
